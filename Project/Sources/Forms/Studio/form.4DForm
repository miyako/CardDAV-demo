{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 1260,
	"windowMinHeight": 840,
	"windowMaxWidth": 1260,
	"windowMaxHeight": 840,
	"width": 1260,
	"height": 840,
	"events": [
		"onLoad",
		"onUnload"
	],
	"windowTitle": "CardDAV — Studio",
	"destination": "detailScreen",
	"method": "method.4dm",
	"pages": [
		{
			"objects": {
				"canvas": {
					"type": "rectangle",
					"left": 0,
					"top": 0,
					"width": 1260,
					"height": 840,
					"fill": "automatic",
					"stroke": "transparent"
